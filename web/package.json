{
  "name": "gitshelves-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "format": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "models:prepare": "bash scripts/prepare-models.sh"
  },
  "dependencies": {
    "three": "0.179.1"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.12.0",
    "@types/three": "0.179.0",
    "eslint": "9.33.0",
    "globals": "16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.40.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
