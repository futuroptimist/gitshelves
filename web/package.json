{
  "name": "gitshelves-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare:models": "python ../scripts/prepare_web_models.py",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "format": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "three": "0.179.1"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@playwright/test": "1.55.0",
    "@types/three": "0.179.0",
    "eslint": "9.33.0",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.40.0",
    "vite": "7.1.3",
    "vitest": "3.2.4"
  }
}
